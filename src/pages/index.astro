---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Chooser from '../components/Chooser.astro';
import Coverage from '../components/Coverage.astro';
import Timeline from '../components/Timeline.astro';
import LocalBand from '../components/LocalBand.astro';
import MeetAgent from '../components/MeetAgent.astro';
import PlainAnswers from '../components/PlainAnswers.astro';
import Reviews from '../components/Reviews.astro';
import EasyToRead from '../components/EasyToRead.astro';
import photos from '../data/photos.json';

const hero = (photos as Record<string, { widths: number[] }>).hero;
const heroSrcset = hero.widths.map((w) => `/photos/hero-${w}.avif ${w}w`).join(', ');
---
<Base
  title="Home"
  description="A local, independent Medicare and life insurance agent in McKees Rocks, PA. One person, one phone number, plain answers."
  heroSrcset={heroSrcset}
>
  <Hero />
  <Chooser />
  <Timeline />
  <Coverage />
  <LocalBand />
  <MeetAgent />
  <PlainAnswers tone="sage" />
  <Reviews />
  <EasyToRead />
</Base>
