---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Prose from '../components/Prose.astro';
import Icon from '../components/Icon.astro';

const other = [
  { icon: 'tooth', title: 'Dental, vision and hearing', body: 'Original Medicare covers little routine dental, vision or hearing care. Standalone plans can help.' },
  { icon: 'shield', title: 'Cancer, heart attack and stroke', body: 'Pays a cash benefit if you are diagnosed with a covered illness, to use however you need.' },
  { icon: 'home', title: 'Short-term care', body: 'Helps with care at home or in a facility for a limited time after an illness or injury.' },
] as const;
---
<Base title="More coverage" description="Hospital indemnity, dental, vision and other coverage, explained plainly by a local agent in McKees Rocks, PA.">
  <PageHeader
    eyebrow="More coverage"
    title="The smaller policies that fill real gaps."
    intro="These are not for everyone. They can make sense once your main Medicare coverage is set and you know where the gaps are."
  />

  <Prose heading="Hospital indemnity." eyebrow="Most asked about">
    <p>A hospital indemnity plan pays you a set cash amount for each day you are in the hospital, or for certain stays. The money comes to you, not the hospital, so you can put it toward a copay, a ride home or groceries.</p>
    <p>It works alongside Medicare Advantage or Original Medicare. It is not Medicare, and it is not a replacement for it.</p>
    <p><strong>When it can help:</strong> if your plan has daily hospital copays and a longer stay would strain your budget. We look at your plan’s costs first to see if it is worth it.</p>
  </Prose>

  <section class="section-pad bg-sage" aria-labelledby="other-h">
    <div class="wrap">
      <div class="max-w-[42rem]" data-reveal>
        <p class="eyebrow">Other coverage</p>
        <h2 id="other-h" class="mt-3">A few more worth knowing about.</h2>
      </div>
      <ul class="mt-10 grid gap-6 md:grid-cols-3" data-stagger role="list">
        {other.map((o) => (
          <li class="card p-6 md:p-8">
            <span class="flex h-12 w-12 items-center justify-center rounded-full bg-clay-wash text-clay-ink"><Icon name={o.icon} size={26} /></span>
            <h3 class="mt-4">{o.title}</h3>
            <p class="mt-2">{o.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>
