---
/*
 * Turning-65 timeline: the 7-month Initial Enrollment Period.
 * Every claim checked 2026-09-28 against:
 *   IEP length, coverage start dates, birthday-on-the-1st rule:
 *     https://www.medicare.gov/basics/get-started-with-medicare/sign-up/when-does-medicare-coverage-start
 *   Automatic enrollment with Social Security benefits 4+ months before 65:
 *     https://www.medicare.gov/basics/get-started-with-medicare/sign-up/how-do-i-sign-up-for-medicare
 *   Late enrollment penalties exist and usually last as long as you have the coverage:
 *     https://www.medicare.gov/basics/costs/medicare-costs/avoid-penalties
 *   Medigap Open Enrollment, 6 months from the first month with Part B at 65+:
 *     https://www.medicare.gov/health-drug-plans/medigap/basics
 * No dollar amounts or percentages on purpose.
 */
interface Props { compact?: boolean }
const { compact = false } = Astro.props;

const steps = [
  {
    when: '3 months before',
    title: 'Your window opens',
    body: 'Sign up now if you are not being enrolled automatically. Coverage can start the month you turn 65.',
  },
  {
    when: '2 months before',
    title: 'Compare your options',
    body: 'Original Medicare with a Medigap and drug plan, or a Medicare Advantage plan. We lay them side by side.',
  },
  {
    when: '1 month before',
    title: 'Choose and apply',
    body: 'Sign up before your birthday month and your coverage starts on the first day of it.',
  },
  {
    when: 'Your birthday month',
    title: 'You turn 65',
    body: 'Premium-free Part A usually starts this month. Sign up now and coverage starts the first of next month.',
    birthday: true,
  },
  {
    when: '1 month after',
    title: 'Still open',
    body: 'You can still sign up. Coverage starts the first of the month after you do.',
  },
  {
    when: '2 months after',
    title: 'Mind the Medigap clock',
    body: 'Once you have Part B at 65 or older, a 6-month Medigap Open Enrollment is already running.',
  },
  {
    when: '3 months after',
    title: 'Your window closes',
    body: 'After this, you may wait for a later sign-up period and could owe a late penalty, unless you have work coverage.',
  },
];
---
<section id="turning-65" class:list={['section-pad', compact ? '' : 'bg-sage']} aria-labelledby="timeline-heading">
  <div class="wrap">
    <div class="max-w-[46rem]" data-reveal>
      <p class="eyebrow">Turning 65</p>
      <h2 id="timeline-heading" class="mt-3">Turning 65 this year? Start here.</h2>
      <p class="mt-4">
        You get seven months to sign up for Medicare the first time. It is called the Initial Enrollment Period, and it is built around the month you turn 65. Here is what to do in each part of it.
      </p>
    </div>

    <ol class="timeline mt-12" data-timeline>
      <span class="timeline-track" aria-hidden="true"><span class="timeline-fill" data-timeline-fill></span></span>
      {steps.map((s) => (
        <li class:list={['timeline-step', s.birthday && 'is-birthday']} data-timeline-step>
          <span class="timeline-dot" aria-hidden="true"></span>
          <div class="timeline-card">
            <p class="text-[1rem] font-bold tracking-[0.04em] text-clay-ink uppercase">{s.when}</p>
            <h3 class="mt-1 text-[1.3rem]">{s.title}</h3>
            <p class="mt-2 text-[1.0625rem] leading-relaxed">{s.body}</p>
          </div>
        </li>
      ))}
    </ol>

    <div class="mt-10 grid gap-4 md:grid-cols-2" data-reveal>
      <p class="rounded-[var(--radius-soft)] bg-white p-5 text-[1.0625rem] md:p-6">
        <strong class="text-river">Birthday on the 1st?</strong> Your window shifts one month earlier: four months before through two months after, and coverage generally starts the month before you turn 65.
      </p>
      <p class="rounded-[var(--radius-soft)] bg-white p-5 text-[1.0625rem] md:p-6">
        <strong class="text-river">Still working?</strong> If you or your spouse have coverage from a current job, the rules are different. See the answers below, or call and we will check your dates.
      </p>
    </div>
    <p class="mt-6 text-[1rem] text-ink-soft">
      Source: <a href="https://www.medicare.gov/basics/get-started-with-medicare/sign-up/when-does-medicare-coverage-start" rel="noopener">Medicare.gov, "When does Medicare coverage start?"</a>
    </p>
  </div>
</section>

<style>
  .timeline {
    --dot: 1.5rem;
    position: relative;
    display: grid;
    gap: 1.25rem;
    padding-left: calc(var(--dot) + 1.25rem);
  }
  .timeline-track {
    position: absolute;
    left: calc(var(--dot) / 2 - 2px);
    top: 0.5rem;
    bottom: 0.5rem;
    width: 4px;
    border-radius: 4px;
    background: var(--color-line);
  }
  .timeline-fill {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--color-river);
    transform-origin: top;
    transform: scaleY(1);
  }
  :global(.will-draw) .timeline-fill { transform: scaleY(var(--draw, 0)); }
  .timeline-step { position: relative; }
  .timeline-dot {
    position: absolute;
    left: calc(-1 * (var(--dot) + 1.25rem));
    top: 1.35rem;
    width: var(--dot);
    height: var(--dot);
    border-radius: 999px;
    background: var(--color-river);
    border: 4px solid var(--color-paper);
    box-shadow: 0 0 0 2px var(--color-river);
    transition: background-color 300ms ease, box-shadow 300ms ease;
  }
  :global(.will-draw) .timeline-step:not(.is-reached) .timeline-dot { background: var(--color-paper); }
  .timeline-card {
    background: #fff;
    border: 1px solid var(--color-line);
    border-radius: 1rem;
    padding: 1.1rem 1.25rem 1.25rem;
    transition: border-color 300ms ease, box-shadow 300ms ease;
  }
  .is-birthday .timeline-card {
    background: var(--color-river);
    border-color: var(--color-river);
  }
  .is-birthday .timeline-card :is(h3, p) { color: #fff; }
  .is-birthday .timeline-dot { background: var(--color-clay); box-shadow: 0 0 0 2px var(--color-clay); }
  :global(.will-draw) .is-birthday:not(.is-reached) .timeline-dot { background: var(--color-paper); }

  /* Horizontal on wide screens */
  @media (min-width: 72rem) {
    .timeline {
      grid-template-columns: repeat(7, minmax(0, 1fr));
      gap: 0.9rem;
      padding-left: 0;
      padding-top: calc(var(--dot) + 1.5rem);
    }
    .timeline-track {
      left: calc(100% / 14);
      right: calc(100% / 14);
      top: calc(var(--dot) / 2 - 2px);
      bottom: auto;
      width: auto;
      height: 4px;
    }
    .timeline-fill { transform-origin: left; transform: scaleX(1); }
    :global(.will-draw) .timeline-fill { transform: scaleX(var(--draw, 0)); }
    .timeline-dot {
      left: calc(50% - var(--dot) / 2);
      top: calc(-1 * (var(--dot) + 1.5rem));
    }
    .timeline-card { height: 100%; padding: 1rem; }
    .timeline-card h3 { font-size: 1.15rem; }
    .timeline-card p:last-child { font-size: 1rem; }
  }
  /* Large text on wide screens: fall back to the vertical layout so nothing overlaps */
  @media (min-width: 72rem) {
    :global(html[data-size='xl']) .timeline,
    :global(html[data-size='lg']) .timeline {
      grid-template-columns: 1fr;
      padding-top: 0;
      padding-left: calc(var(--dot) + 1.25rem);
      max-width: 52rem;
    }
    :global(html[data-size='xl']) .timeline-track,
    :global(html[data-size='lg']) .timeline-track {
      left: calc(var(--dot) / 2 - 2px); right: auto; top: 0.5rem; bottom: 0.5rem; width: 4px; height: auto;
    }
    :global(html[data-size='xl']) .timeline-fill,
    :global(html[data-size='lg']) .timeline-fill { transform-origin: top; transform: scaleY(var(--draw, 1)); }
    :global(html[data-size='xl']) .timeline-dot,
    :global(html[data-size='lg']) .timeline-dot { left: calc(-1 * (var(--dot) + 1.25rem)); top: 1.35rem; }
  }
</style>
