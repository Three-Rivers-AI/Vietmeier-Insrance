---
// Demo form: posts nowhere. Never add fields for Medicare number, SSN, date of birth,
// medications or health conditions.
import { productLines, site } from '../data/site';
import MedicareDisclaimer from './MedicareDisclaimer.astro';
import Icon from './Icon.astro';

const input =
  'mt-2 block min-h-14 w-full rounded-xl border-2 border-ink-soft/60 bg-white px-4 py-3 text-[1.1875rem] text-ink focus:border-river focus:outline-3 focus:outline-offset-2 focus:outline-clay-ink aria-invalid:border-[#A3321F]';
const label = 'block text-[1.125rem] font-bold text-ink';
const hint = 'mt-1 block text-[1rem] text-ink-soft';
const error = 'field-error mt-2 flex items-start gap-2 text-[1.0625rem] font-bold text-[#A3321F]';
---
<div id="book" class="scroll-mt-32">
  <form id="contact-form" class="card grid gap-7 p-6 md:p-10" novalidate aria-labelledby="form-heading">
    <div>
      <h2 id="form-heading" class="text-[clamp(1.6rem,1.3rem+1vw,2.1rem)]">Ask for a call back</h2>
      <p class="mt-2 text-ink-soft">Takes about a minute. I will call at the time you pick. Fields marked required are the only ones you need.</p>
    </div>

    <div id="form-errors" class="hidden rounded-xl border-2 border-[#A3321F] bg-[#FBEDE9] p-5" role="alert" tabindex="-1">
      <p class="font-bold text-[#7A2415]">A couple of things need a look before this can send.</p>
      <ul class="mt-2 list-disc pl-6 text-ink" data-error-list></ul>
    </div>

    <div>
      <label for="f-name" class={label}>Your name <span class="font-normal text-ink-soft">(required)</span></label>
      <input id="f-name" name="name" type="text" autocomplete="name" class={input} aria-describedby="f-name-err" required />
      <p id="f-name-err" class={error} hidden></p>
    </div>

    <div class="grid gap-7 md:grid-cols-2">
      <div>
        <label for="f-phone" class={label}>Phone <span class="font-normal text-ink-soft">(required)</span></label>
        <span id="f-phone-hint" class={hint}>Type it any way you like, with or without dashes.</span>
        <input id="f-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" class={input} aria-describedby="f-phone-hint f-phone-err" required />
        <p id="f-phone-err" class={error} hidden></p>
      </div>
      <div>
        <label for="f-email" class={label}>Email <span class="font-normal text-ink-soft">(optional)</span></label>
        <span id="f-email-hint" class={hint}>Only if you would like a note back by email.</span>
        <input id="f-email" name="email" type="email" autocomplete="email" class={input} aria-describedby="f-email-hint f-email-err" />
        <p id="f-email-err" class={error} hidden></p>
      </div>
    </div>

    <div class="grid gap-7 md:grid-cols-2">
      <div>
        <label for="f-zip" class={label}>Zip code <span class="font-normal text-ink-soft">(required)</span></label>
        <span id="f-zip-hint" class={hint}>Plans depend on where you live.</span>
        <input id="f-zip" name="zip" type="text" inputmode="numeric" autocomplete="postal-code" maxlength="10" class={input} aria-describedby="f-zip-hint f-zip-err" required />
        <p id="f-zip-err" class={error} hidden></p>
      </div>
      <div>
        <label for="f-time" class={label}>Best time to call</label>
        <span id="f-time-hint" class={hint}>Weekdays unless you tell me otherwise.</span>
        <select id="f-time" name="time" class={input} aria-describedby="f-time-hint">
          <option>Any time</option>
          <option>Morning, 9 to noon</option>
          <option>Afternoon, noon to 4</option>
          <option>Early evening, 4 to 7</option>
          <option>Saturday morning</option>
        </select>
      </div>
    </div>

    <fieldset>
      <legend class={label}>What can we help with? <span class="font-normal text-ink-soft">(pick any)</span></legend>
      <div class="mt-3 grid gap-3 sm:grid-cols-2">
        {productLines.map((p, i) => (
          <label class="flex min-h-14 cursor-pointer items-center gap-3 rounded-xl border-2 border-line bg-paper px-4 py-2 has-checked:border-river has-checked:bg-sage">
            <input type="checkbox" name="help" value={p} id={`f-help-${i}`} class="h-6 w-6 shrink-0 accent-river" />
            <span>{p}</span>
          </label>
        ))}
      </div>
    </fieldset>

    <div>
      <label class="flex cursor-pointer items-start gap-4 rounded-xl border-2 border-line bg-paper p-4 has-checked:border-river">
        <input id="f-consent" name="consent" type="checkbox" class="mt-1 h-7 w-7 shrink-0 accent-river" aria-describedby="f-consent-err" />
        <span>I agree to be contacted by Vietmeier Insurance by phone, text or email about the products I selected. Consent is not a condition of purchase.</span>
      </label>
      <p id="f-consent-err" class={error} hidden></p>
    </div>

    <p class="text-[1rem] text-ink-soft">I will never ask for your Medicare number, Social Security number, date of birth or health details on this site.</p>

    <button type="submit" class="btn btn-primary min-h-16 w-full text-[1.3rem] md:w-auto md:justify-self-start md:px-10">
      Send my request
    </button>
  </form>

  <div id="form-thanks" class="card p-6 md:p-10" hidden tabindex="-1" role="status" aria-live="polite">
    <span class="flex h-14 w-14 items-center justify-center rounded-full bg-sage text-river"><Icon name="check" size={32} /></span>
    <h2 class="mt-5 text-[clamp(1.6rem,1.3rem+1vw,2.1rem)]">Thank you, <span data-thanks-name>neighbor</span>. I will call you soon.</h2>
    <p class="mt-4">I will call from {site.phoneShort} at the time you picked. If you would rather not wait, call me now. And if you change your mind, just say so when I call. No hard feelings.</p>
    <p class="mt-4 rounded-xl bg-clay-wash p-4 text-[1.0625rem]"><strong>This is a concept site.</strong> Nothing was sent anywhere, and nothing you typed was saved.</p>
    <div class="mt-6 rounded-xl border border-line bg-paper p-5 text-[1.0625rem]">
      <MedicareDisclaimer />
    </div>
    <a href={`tel:${site.phoneTel}`} class="btn btn-primary mt-7"><Icon name="phone" /> Call {site.phoneShort}</a>
  </div>
</div>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const thanks = document.getElementById('form-thanks');
  const summary = document.getElementById('form-errors');

  const setError = (id: string, message: string) => {
    const field = document.getElementById(id) as HTMLInputElement;
    const err = document.getElementById(`${id}-err`)!;
    if (message) {
      field.setAttribute('aria-invalid', 'true');
      err.innerHTML = `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" class="mt-0.5 shrink-0"><circle cx="12" cy="12" r="9"/><path d="M12 7.5v5.5M12 16.5v.5"/></svg><span>${message}</span>`;
      err.hidden = false;
    } else {
      field.removeAttribute('aria-invalid');
      err.hidden = true;
      err.textContent = '';
    }
    return message;
  };

  // Accept phone numbers typed any way: (412) 555-0142, 412.555.0142, +1 412 555 0142...
  const phoneDigits = (v: string) => {
    let d = v.replace(/\D/g, '');
    if (d.length === 11 && d.startsWith('1')) d = d.slice(1);
    return d;
  };
  const formatPhone = (d: string) => `(${d.slice(0, 3)}) ${d.slice(3, 6)}-${d.slice(6)}`;

  const rules: Record<string, (f: HTMLFormElement) => string> = {
    'f-name': (f) => ((f.elements.namedItem('name') as HTMLInputElement).value.trim() ? '' : 'Please tell me your name, so I know who to ask for.'),
    'f-phone': (f) => {
      const v = (f.elements.namedItem('phone') as HTMLInputElement).value;
      if (!v.trim()) return 'Please add a phone number so I can call you back.';
      return phoneDigits(v).length === 10 ? '' : 'That number looks short or long. A U.S. number has 10 digits, like 412-555-0142.';
    },
    'f-email': (f) => {
      const v = (f.elements.namedItem('email') as HTMLInputElement).value.trim();
      return !v || /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v) ? '' : 'That email looks incomplete. It should look like name@example.com. You can also leave it blank.';
    },
    'f-zip': (f) => {
      const v = (f.elements.namedItem('zip') as HTMLInputElement).value.trim();
      if (!v) return 'Please add your zip code. Plans depend on where you live.';
      return /^\d{5}(-?\d{4})?$/.test(v) ? '' : 'A zip code has 5 numbers, like 15136.';
    },
    'f-consent': (f) => ((f.elements.namedItem('consent') as HTMLInputElement).checked ? '' : 'Please check this box so I have your OK to contact you.'),
  };

  if (form && thanks && summary) {
    // Clear an error as soon as the field is fixed, while typing. We never re-check on blur:
    // removing a message on blur shifts the layout under the next tap and makes it miss.
    Object.keys(rules).forEach((id) => {
      const el = document.getElementById(id)!;
      el.addEventListener(el.getAttribute('type') === 'checkbox' ? 'change' : 'input', () => {
        if (el.getAttribute('aria-invalid') === 'true' && !rules[id](form)) setError(id, '');
      });
    });

    const phone = document.getElementById('f-phone') as HTMLInputElement;
    phone.addEventListener('blur', () => {
      const d = phoneDigits(phone.value);
      if (d.length === 10) phone.value = formatPhone(d);
    });

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const problems = Object.keys(rules)
        .map((id) => ({ id, msg: setError(id, rules[id](form)) }))
        .filter((p) => p.msg);

      const list = summary.querySelector('[data-error-list]')!;
      list.innerHTML = '';
      if (problems.length) {
        problems.forEach((p) => {
          const li = document.createElement('li');
          const a = document.createElement('a');
          a.href = `#${p.id}`;
          a.textContent = p.msg;
          a.addEventListener('click', (ev) => {
            ev.preventDefault();
            document.getElementById(p.id)!.focus();
          });
          li.appendChild(a);
          list.appendChild(li);
        });
        summary.classList.remove('hidden');
        summary.focus();
        return;
      }
      summary.classList.add('hidden');
      const name = (form.elements.namedItem('name') as HTMLInputElement).value.trim().split(/\s+/)[0];
      thanks.querySelector('[data-thanks-name]')!.textContent = name || 'neighbor';
      form.reset();
      form.hidden = true;
      thanks.hidden = false;
      thanks.focus();
      thanks.scrollIntoView({ block: 'start', behavior: 'auto' });
    });
  }
</script>
