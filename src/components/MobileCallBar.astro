---
import { site } from '../data/site';
import Icon from './Icon.astro';
---
<div class="call-bar fixed inset-x-0 bottom-0 z-40 border-t border-line bg-paper/97 pb-[env(safe-area-inset-bottom)] shadow-[0_-8px_24px_-12px_rgb(43_42_40/0.25)] lg:hidden">
  <div class="wrap grid grid-cols-2 gap-3 py-2.5">
    <a href={`tel:${site.phoneTel}`} class="btn btn-secondary whitespace-nowrap px-3">
      <Icon name="phone" size={22} class="bar-icon" /> Call
    </a>
    <a href={site.bookHref} class="btn btn-primary whitespace-nowrap px-3">
      <Icon name="calendar" size={22} class="bar-icon" /> Book a call
    </a>
  </div>
</div>
<style>
  /* At the largest text size on small phones, drop the icons so labels stay on one line. */
  @media (max-width: 26rem) {
    :global(html[data-size='xl']) .call-bar :global(.bar-icon) { display: none; }
    :global(html[data-size='xl']) .call-bar .btn { font-size: 1rem; }
  }
</style>
