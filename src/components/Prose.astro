---
// Simple content section: heading + body in a readable column.
interface Props { id?: string; heading: string; eyebrow?: string; tone?: 'paper' | 'sage'; }
const { id, heading, eyebrow, tone = 'paper' } = Astro.props;
const hid = `${id ?? heading.toLowerCase().replace(/[^a-z0-9]+/g, '-').slice(0, 40)}-h`;
---
<section id={id} class:list={['section-pad', tone === 'sage' && 'bg-sage']} aria-labelledby={hid}>
  <div class="wrap grid grid-cols-1 gap-8 lg:grid-cols-[1fr_1.6fr] lg:gap-16">
    <div data-reveal>
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h2 id={hid} class:list={[eyebrow && 'mt-3']}>{heading}</h2>
    </div>
    <div class="prose-body grid max-w-[42rem] gap-5" data-reveal>
      <slot />
    </div>
  </div>
</section>
<style>
  .prose-body :global(h3) { margin-top: 0.75rem; }
  .prose-body :global(ul) { display: grid; gap: 0.75rem; padding-left: 0; list-style: none; }
  .prose-body :global(ul > li) { position: relative; padding-left: 2rem; }
  .prose-body :global(ul > li)::before {
    content: ''; position: absolute; left: 0.3rem; top: 0.6em; width: 0.7rem; height: 0.7rem;
    border-radius: 999px; background: var(--color-clay);
  }
</style>
