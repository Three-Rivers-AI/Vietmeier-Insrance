---
import { answers, type Answer } from '../data/answers';
import Icon from './Icon.astro';

interface Props {
  ids?: string[];
  heading?: string;
  intro?: string;
  tone?: 'paper' | 'sage';
}
const {
  ids,
  heading = 'Plain answers to the questions I hear every week.',
  intro = 'No jargon. If your situation is different, that is what the phone call is for.',
  tone = 'paper',
} = Astro.props;
const list: Answer[] = ids ? answers.filter((a) => ids.includes(a.id)) : answers;
const hid = `answers-heading-${ids ? ids[0] : 'all'}`;
---
<section id="plain-answers" class:list={['section-pad', tone === 'sage' && 'bg-sage']} aria-labelledby={hid}>
  <div class="wrap grid gap-10 lg:grid-cols-[1fr_1.7fr] lg:gap-16">
    <div data-reveal>
      <p class="eyebrow">Plain Answers</p>
      <h2 id={hid} class="mt-3">{heading}</h2>
      <p class="mt-4 text-ink-soft">{intro}</p>
    </div>
    <div class="grid gap-3" data-stagger>
      {list.map((item) => (
        <details class="acc card overflow-hidden" id={`q-${item.id}`}>
          <summary class="flex min-h-16 items-start justify-between gap-4 p-5 md:p-6">
            <span class="font-serif text-[1.25rem] leading-snug font-semibold text-river md:text-[1.375rem]">{item.q}</span>
            <span class="acc-icon mt-0.5 flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-sage text-river" aria-hidden="true">
              <Icon name="plus" size={22} />
            </span>
          </summary>
          <div class="acc-body">
            <div class="grid gap-4 px-5 pb-6 md:px-6">
              {item.a.map((p) => <p>{p}</p>)}
            </div>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  summary:hover span:first-child { text-decoration: underline; text-decoration-thickness: 0.06em; text-underline-offset: 0.2em; }
</style>
